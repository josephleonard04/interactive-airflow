{
  "name": "roomdesig",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:scene-graph": "node --experimental-strip-types scripts/check-scene-graph.ts",
    "check:zones": "node --experimental-strip-types scripts/check-zones.ts",
    "check:zone-metrics": "node --experimental-strip-types scripts/check-zone-metrics.ts",
    "check:headless": "node --experimental-strip-types scripts/check-headless-evaluate.ts",
    "check:intent": "node --experimental-strip-types scripts/check-intent-types.ts && node --experimental-strip-types scripts/check-intent-parse.ts && node --experimental-strip-types scripts/check-intent-mapper.ts && node --experimental-strip-types scripts/check-intent-session.ts",
    "check:sketch": "node --experimental-strip-types scripts/check-sketch-phase2.ts",
    "check:optimizer": "node --experimental-strip-types scripts/check-optimizer.ts",
    "check:phase5": "node --experimental-strip-types scripts/check-phase5.ts",
    "check:phase6": "node --experimental-strip-types scripts/check-phase6.ts",
    "check:llm": "node --experimental-strip-types scripts/check-llm-route.ts",
    "check:openfoam": "node --experimental-strip-types scripts/check-openfoam-export.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@webgpu/types": "^0.1.71",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
